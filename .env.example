# Cielo Cloud Fiscal — variables de entorno del servidor
# En local: copia este archivo como .env.local y rellena los valores.
# En Vercel: Project Settings → Environment Variables.
# .env.local está en .gitignore: nunca subas valores reales al repo.
#
# Ninguna lleva el prefijo NEXT_PUBLIC_: no llegan al navegador.

# API key de Anthropic para la lectura de facturas (src/app/api/ocr/route.ts).
# Usa una key propia del producto, no una personal.
ANTHROPIC_API_KEY=

# Código de acceso que protege la ruta de OCR mientras no haya cuentas. Sin
# él, cualquiera que conozca la URL podría gastar la API key. Elige una frase
# larga y difícil de adivinar; el contador la escribe una vez en Configuración.
OCR_CODIGO_ACCESO=
