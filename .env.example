# Cielo Cloud Fiscal — variables de entorno
# Copia este archivo como .env.local y rellena los valores. .env.local está
# en .gitignore: nunca subas valores reales al repo.

# ── Firebase (cliente) ───────────────────────────────────────────────────────
# Consola de Firebase → Configuración del proyecto → Tus apps → SDK config.
# Proyecto NUEVO, separado del de Cielo Cloud Nómina.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (solo servidor — API routes) ──────────────────────────────
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada. Sin prefijo NEXT_PUBLIC_: nunca llegan al
# navegador. La private key va en una sola línea con los saltos como \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Anthropic (solo servidor — src/app/api/ocr/route.ts) ─────────────────────
# Key propia del producto, no una key personal.
ANTHROPIC_API_KEY=
